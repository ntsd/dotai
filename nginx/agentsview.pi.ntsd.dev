# Map connection upgrade based on client request headers for WebSocket (WSS) and HTTPS
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 10002 ssl http2;
    listen 1002 ssl http2;
    server_name pi.ntsd.dev;

    ssl_certificate     /etc/letsencrypt/live/pi.ntsd.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pi.ntsd.dev/privkey.pem;

    client_max_body_size 50m;

    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # Client IP and protocol forwarding
        proxy_set_header   Host              $http_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # WebSocket and SSE streaming support
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;

        # Disable buffering for real-time streaming and UI updates
        proxy_buffering    off;

        # Extended timeouts for persistent WebSocket / SSE connections
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
